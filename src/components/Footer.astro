---
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <h2>Kairos CV</h2>
      <p class="footer-copy">Movimiento juvenil que busca acompañar, servir y crecer en comunidad, espiritualidad y servicio.</p>
    </div>
    <div>
      <p class="footer-label">Explora</p>
      <a href="/movimiento">Sobre el movimiento</a>
      <a href="/retiro">Próximo retiro</a>
      <a href="/contacto">Contacto</a>
    </div>
    <div>
      <p class="footer-label">Conecta</p>
      <a href="https://instagram.com" target="_blank" rel="noreferrer">Instagram</a>
      <a href="https://facebook.com" target="_blank" rel="noreferrer">Facebook</a>
      <a href="/registro">Registrarme</a>
    </div>
  </div>
  <div class="container footer-bottom"><span>© {new Date().getFullYear()} Movimiento {site.fullName}</span><span>Anchored in faith, moving in love.</span></div>
</footer>
